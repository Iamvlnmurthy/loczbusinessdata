# Copy to .env and fill in. Never commit .env.
LOCZ_DSN=host=127.0.0.1 port=5433 dbname=locz_engine user=postgres password=CHANGE_ME

# Identifies us to every source we fetch from. Keep a real contact address here:
# it is what a data provider uses to reach us instead of blocking us.
LOCZ_USER_AGENT=LocZ-Pincode-Business-Engine/0.1 (contact@example.com)

# Overture release to pin. Bump deliberately, not automatically — a new release
# changes record counts and therefore export checksums.
OVERTURE_RELEASE=2026-07-22.0

MONITOR_PORT=8420
